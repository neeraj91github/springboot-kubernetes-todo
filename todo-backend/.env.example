# Database
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=todo_app;trustServerCertificate=true
DB_USER=SA
DB_PASS=CHANGE_ME
DB_DIALECT=org.hibernate.dialect.SQLServerDialect
HIBERNATE_DDL_AUTO=update

# Security
# ENCRYPTION_KEY must be exactly 16, 24, or 32 characters.
ENCRYPTION_KEY=CHANGE_ME_16_CHAR

# JWT_SECRET must be a Base64-encoded random key of at least 256 bits.
JWT_SECRET=CHANGE_ME_BASE64_256_BIT_SECRET

SERVER_PORT=9090
